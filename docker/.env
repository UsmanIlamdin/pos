# =============================================================
#  BrainCortex — Production Docker Environment
#  Edit this file to configure your local deployment.
# =============================================================

# -------------------------------------------------------
# APP
# -------------------------------------------------------
# Hostname used to access the app (no http:// prefix, no port)
# For local: localhost  |  For custom: pos.local, myshop.local …
APP_DOMAIN=ghazi-pos.local

# Wi‑Fi / LAN IP used in Traefik Host rules.
# start.sh auto-detects and writes this on every start so rebuilds keep working.
# To pin a fixed IP instead, set LAN_IP_PINNED=true below.
LAN_IP=192.168.100.74
# LAN_IP_PINNED=true

# Port Traefik listens on for HTTP traffic (redirects to HTTPS)
APP_PORT=80

# Port Traefik listens on for HTTPS traffic
APP_HTTPS_PORT=443

# Force the PHP app to treat requests as HTTPS
FORCE_HTTPS=true

# Traefik dashboard port (web UI showing routes)
TRAEFIK_DASHBOARD_PORT=8080

# PHP timezone
PHP_TIMEZONE=UTC

# CodeIgniter environment (production | development)
CI_ENVIRONMENT=production

# -------------------------------------------------------
# DATABASE — MariaDB
# -------------------------------------------------------
MYSQL_ROOT_PASSWORD=Admin@123
MYSQL_DATABASE=pos
MYSQL_USER=admin
MYSQL_PASSWORD=Admin@123

# -------------------------------------------------------
# BACKUP
# -------------------------------------------------------
# How often to run a backup (in hours). Default: 12
BACKUP_INTERVAL_HOURS=12

# How many days of backup files to keep. Default: 7
BACKUP_KEEP_DAYS=7
